PROGRAM PLC_PRG
VAR
END_VAR

(* Parada de Emergência – zera todas as saídas e estados *)
IF NOT GVL.Emergency_Stop THEN
    %QD0  := 0;
    %MD0  := 0;
    GVL.Step := 0;
    GVL.InspectionStep := 0;
    GVL.ConsecutiveRejects := 0;
    GVL.ProductAtInspection := FALSE;
END_IF

(* Start / Stop / Reset *)
IF GVL.Emergency_Stop THEN
    // Start
    IF GVL.Start THEN
        GVL.Enable := TRUE;
        GVL.Stopping := FALSE;
        GVL.Step := 0;
        GVL.InspectionStep := 0;
        GVL.Tag[1] := TRUE;
        GVL.Tag[2] := TRUE;
        GVL.ConsecutiveRejects := 0;
    END_IF
    
    // Stop
    IF NOT GVL.Stop THEN
        GVL.Stopping := TRUE;
    END_IF
    
    // Reset
    IF GVL.Reset THEN
        GVL.Reset_Light := TRUE;
        GVL.InspectionStep := 0;
        GVL.ConsecutiveRejects := 0;
        GVL.AlarmLight := FALSE;
    ELSE
        GVL.Reset_Light := FALSE;
    END_IF
    
    // Enable
    IF GVL.Enable THEN
        GVL.Stop_Light := FALSE;
        GVL.Start_Light := TRUE;
    ELSE
        GVL.Start_Light := FALSE;
        GVL.Stop_Light  := TRUE;
    END_IF
END_IF

GVL.Clock();
IF GVL.Emergency_Stop AND GVL.Enable AND GVL.Stopping THEN
    GVL.Clock.ENABLE := TRUE;
    GVL.Stop_Light := GVL.Clock.OUT;
ELSIF NOT GVL.Stopping THEN
    GVL.Clock.ENABLE := FALSE;
END_IF

Abastecimento_e_Contador();
Manipulador();
Inspecao_e_Classificacao();
