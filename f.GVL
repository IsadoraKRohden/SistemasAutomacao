    QualityFault : BOOL := FALSE;

(* ENTRADAS DIGITAIS*)

    Moving_X : BOOL;
    Moving_Z : BOOL;
    Item_detected : BOOL;

    Lid_at_place : BOOL;
    Lid_clamped : BOOL;
    Base_at_place : BOOL;
    Base_clamped : BOOL;
    Pos_at_limit_lids : BOOL;
    Pos_at_limit_bases : BOOL;
    Part_leaving : BOOL;

    Start : BOOL;
    Stop : BOOL;
    Reset : BOOL;
