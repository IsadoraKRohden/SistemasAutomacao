    ApprovedSensor : BOOL;
    RejectedSensor : BOOL;

    WeightValue : WORD;

(* SAÍDAS DIGITAIS*)

    Move_X : BOOL;
    Move_Z : BOOL;
    Grab : BOOL;

    Lids_conveyor : BOOL;
    Bases_conveyor : BOOL;
