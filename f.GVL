VAR_GLOBAL
(* Sistema *)
    Enable : BOOL;
    Stopping : BOOL;
    Assembler_step : INT;
	Inspection_step : INT;
    Clock : Blink;					
    Tag : ARRAY[1..2] OF BOOL;		//intercomunicação de programas
	Quality_fault : BOOL := FALSE;
    
(* ENTRADAS DIGITAIS*)
    Moving_X : BOOL;
    Moving_Z : BOOL;
    Item_detected : BOOL;
    Lid_at_place: BOOL;
    Lid_clamped : BOOL;
    Pos_at_limit_lids : BOOL;
    Base_at_place : BOOL;
    Base_clamped : BOOL;
    Pos_at_limit_bases : BOOL;
    Part_leaving : BOOL;
	
    Start : BOOL;
	Stop : BOOL;
    Reset : BOOL;
    Emergency_stop : BOOL;
    Auto : BOOL;
    Manual : BOOL;
    FIO_Running : BOOL;
	
    Inductive_sensor  : BOOL;
	Inspection_sensor  : BOOL;
	Approved_sensor  : BOOL;
	Rejected_sensor  : BOOL;

    Weight_sensor : REAL;      // Balança (entrada analógica)
    
(* SAÍDAS DIGITAIS*)
    Move_X : BOOL;
    Move_Z : BOOL;
    Grab : BOOL;
    Lids_conveyor : BOOL;
    Clamp_lid : BOOL;
    Pos_raise_lids : BOOL;
    Bases_conveyor : BOOL;
    Clamp_base : BOOL;
    Pos_raise_bases : BOOL;
	Bases_emitter : BOOL;
	Lids_emitter : BOOL;
	
    Start_light : BOOL;
    Reset_light : BOOL;
    Stop_light : BOOL;
	Green_stack : BOOL;
	Yellow_stack : BOOL;
	Red_stack : BOOL;
    
    Pivot_Arm      : BOOL;
	Inspection_conveyor	: BOOL;
	Decision_conveyor	: BOOL;
    
(* CONTADORES *)
    Approved_parts : INT := 0;
	Rejected_parts : INT := 0;
	Consecutive_rejects : INT := 0;
END_VAR
