PROGRAM Manipulador
VAR
	Moving_Z_F_TRIG, Moving_X_F_TRIG: F_TRIG;
END_VAR

(*Bordas de Descida*)
Moving_Z_F_TRIG(CLK := Moving_Z);
Moving_X_F_TRIG(CLK := Moving_X);
CASE Step OF
	0: // Aguardando abastecimento da tampa
		IF Emergency_stop AND Enable AND Lid_clamped THEN
			Step := 1;
		END_IF
	1: // Descer Manipulador (Z On / X Off)
		IF Emergency_stop AND Enable THEN
			Move_Z := TRUE;
			IF Moving_Z_F_TRIG.Q THEN
				Grab := TRUE;
				Step := 2;
			END_IF
		END_IF
	2: // Subir Manipulador (Z Off / X Off)
		IF Emergency_stop AND Enable THEN
			Tag[1] := TRUE;
			Move_Z := FALSE;
			Clamp_lid:= FALSE;
			IF Moving_Z_F_TRIG.Q THEN
				Step := 3;
			END_IF
		END_IF
	3: // Avançar Manipulador (Z Off / X On)
		IF Emergency_stop AND Enable THEN
			Move_X := TRUE;
			IF Moving_X_F_TRIG.Q THEN
				Step := 4;
			END_IF
		END_IF
	4: // Descer Manipulador (Z On / X On)
		IF Emergency_stop AND Enable THEN
			IF Base_clamped THEN
				Move_Z := TRUE;
			END_IF
			IF Moving_Z_F_TRIG.Q THEN
				Pos_raise_bases := TRUE;
				Clamp_base := FALSE;
				Grab := FALSE;
				Step := 5;
			END_IF
		END_IF
	5: // Subir Manipulador (Z Off / X On)
		IF Emergency_stop AND Enable THEN
			Bases_conveyor := TRUE;
			Move_Z := FALSE;
		END_IF
		IF Moving_Z_F_TRIG.Q THEN
			Step := 6;
		END_IF
	6: // Recuar Manipulador (Z Off / X off)
		IF Emergency_stop AND Enable THEN
			Move_X := FALSE;
			IF Moving_X_F_TRIG.Q THEN
				IF NOT Stopping THEN
					Step := 0;
				END_IF
				IF Manual OR Stopping THEN
					Enable := FALSE;
				END_IF
			END_IF
		END_IF
END_CASE
