PROGRAM Inspecao_e_Classificacao
VAR
    Weight_timer : TON; 
END_VAR
//Metal lid (7kg) + Base material (8kg) = 15 kg
//LEITURA BOTÃO APROVADO = 7.0;

  //////////////////////////////////////

CASE FIO.Inspection_step OF

0:    //ESPERA PRODUTO
    FIO.Pivot_arm := FALSE;
    FIO.Inspection_conveyor := TRUE;
    IF FIO.Inspection_sensor THEN
        FIO.Inspection_conveyor := FALSE;
        FIO.Inspection_step := 1;
    END_IF;

1:    //ESTABILIZA PESO
    Weight_timer(
        IN := TRUE,
        PT := T#500ms
    );
    IF Weight_timer.Q THEN				//pra nao dar erro na leitura da balança pq a peça esta entrando
        Weight_timer(IN := FALSE);
        FIO.Inspection_step := 2;
    END_IF;

2:    //DECISÃO
    IF FIO.Inductive_sensor
    AND (FIO.Weight_sensor >= 6.5)
    AND (FIO.Weight_sensor <= 7.5)			//coloquei tolerancia de 0.5
    THEN
        FIO.Inspection_step := 3;
    ELSE
        FIO.Inspection_step := 4;
    END_IF;

3:    //APROVADO
    FIO.Inspection_conveyor := TRUE;
	FIO.Decision_conveyor := TRUE;
    FIO.Inspection_step := 5;

4:    //REJEITADO
    FIO.Pivot_arm := TRUE;
    FIO.Inspection_conveyor := TRUE;
	FIO.Decision_conveyor := TRUE;
    FIO.Inspection_step := 6;

5:    //CONFIRMA APROVAÇÃO
    IF FIO.Approved_sensor THEN
        FIO.Approved_parts := FIO.Approved_parts + 1;		//CONTADOR APROVADAS, visor no painel de controle
		FIO.Consecutive_rejects := 0;
        FIO.Inspection_step := 0;
    END_IF

6:    //CONFIRMA REJEIÇÃO
	IF FIO.Approved_sensor THEN				//SENSOR APROVADO DISPAROU MESMO COM A PEÇA SENDO REJEITADA
    	FIO.Decision_conveyor := FALSE;
    	FIO.Stopping := TRUE;
    	FIO.Quality_fault := TRUE;
    	FIO.Inspection_step := 7;
	END_IF;

    IF FIO.Rejected_sensor THEN			//TRES REJEITADOS CONSECUTIVAMENTE, PROGRAMA PARA
        FIO.Rejected_parts :=
            FIO.Rejected_parts + 1;
        FIO.Consecutive_rejects :=
            FIO.Consecutive_rejects + 1;
        IF FIO.Consecutive_rejects >= 3 THEN
            FIO.Quality_fault := TRUE;
            FIO.Inspection_step := 7;
        ELSE
            FIO.Inspection_step := 0;
        END_IF;
    END_IF;

7: //FALHA DE QUALIDADE
    FIO.Inspection_conveyor := FALSE;
    IF FIO.Reset THEN
        FIO.Quality_Fault := FALSE;
        FIO.Consecutive_Rejects := 0;
        FIO.Inspection_step := 0;
    END_IF;
END_CASE;
